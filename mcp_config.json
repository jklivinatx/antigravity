      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-puppeteer"]
    },
    "fetch": {
      "command": "cmd.exe",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-fetch"]
    },
    "filesystem": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "C:\\Users\\cary\\gravity",
        "C:\\Users\\cary\\Downloads",
        "C:\\Users\\cary\\OneDrive\\Documents\\Archived Notes"
      ]
    },
    "sqlite": {
      "command": "cmd.exe",
      "args": [
        "/c",
        "npx",
        "-y",
        "@modelcontextprotocol/server-sqlite",
        "--db-path",
        "C:\\Users\\cary\\gravity\\workspace.db"
      ]
    },
    "github": {
      "command": "cmd.exe",
      "args": ["/c", "npx", "-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": ""
      }
    },
    "duckduckgo-search": {
      "command": "python",
      "args": ["C:\\Users\\cary\\gravity\\scripts\\ddg_mcp_server.py"]
    }
